# Context 1, mask 0x0100, fixed output PIO_OUT0 (local pin 1).
# Candidate classic WS2812 timing at 50 MHz, not all WS2812 revisions:
# high 360/720 ns, rising-edge intervals 1200/1320 ns.
# Feed complete bytes in wire order (typically GRB), keep TX fed during frame.
# Leave input FIFO empty for >=300 us between frames to latch/reset externally.
    SET 1, 0
byte:
    PULL
    LDX 7
bit:
    JBIT one
    SET 1, 1
    DELAY 1
    SET 1, 0
    SHL
    DELAY 2
    DJNZ bit
    JMP tail
one:
    SET 1, 1
    DELAY 4
    SET 1, 0
    SHL
    DJNZ bit
    NOP
tail:
    JBIT last_one
    SET 1, 1
    DELAY 1
    SET 1, 0
    DELAY 2
    JMP byte
last_one:
    SET 1, 1
    DELAY 4
    SET 1, 0
    JMP byte
